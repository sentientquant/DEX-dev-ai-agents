//@version=5
indicator("VolatilityBracket Strategy - 1025% Backtest Returns (with SL/TP)", overlay=true)

// 🌙 MOON DEV'S VOLATILITY BRACKET STRATEGY - TRADINGVIEW VERSION 🌙
// EXACT replica of production strategy with 1025% BTC, 726% SOL, 236% ETH backtest returns
//
// STRATEGY LOGIC:
// - Keltner Channels (SMA ± multiplier × ATR) for volatility brackets
// - Requires trend confirmation (SMA slope) + RSI bias
// - Breakout detection: Price > Upper Bracket (BUY) or Price < Lower Bracket (SELL)
// - ATR volatility filter: 0.5% - 3.0% of price
// - DYNAMIC STOP LOSS & TAKE PROFIT (matches production dynamic_order_manager.py)
//
// CRITICAL: Uses SMA as anchor (NOT previous close) - this is the key to backtest performance!

// ===========================
// STRATEGY PARAMETERS
// ===========================
atr_period = input.int(14, "ATR Period", minval=1)
multiplier = input.float(1.5, "ATR Multiplier", minval=0.1, step=0.1)
ma_period = input.int(50, "SMA Period", minval=1)
rsi_period = input.int(14, "RSI Period", minval=1)
min_atr_pct = input.float(0.005, "Min ATR % (volatility filter)", minval=0.001, step=0.001)
max_atr_pct = input.float(0.030, "Max ATR % (volatility filter)", minval=0.001, step=0.001)

// SL/TP Parameters (from dynamic_order_manager.py)
base_sl_multiplier = input.float(3.0, "Base SL Multiplier (ATR)", minval=0.5, step=0.1, tooltip="Base stop loss distance (3.0x ATR - wider to avoid premature stops)")
show_sl_tp = input.bool(true, "Show SL/TP Levels", tooltip="Display dynamic Stop Loss and Take Profit levels")

// Display options
show_sma = input.bool(true, "Show SMA Line")
show_brackets = input.bool(true, "Show Keltner Brackets")
show_signals = input.bool(true, "Show Buy/Sell Signals")
show_info = input.bool(true, "Show Info Panel")
info_position = input.string("Top Left", "Info Panel Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"])
info_size = input.string("Normal", "Info Panel Size", options=["Small", "Normal", "Large"])

// ===========================
// INDICATOR CALCULATIONS
// ===========================
atr_value = ta.atr(atr_period)
sma_value = ta.sma(close, ma_period)
rsi_value = ta.rsi(close, rsi_period)

// Volume analysis for signal confirmation
volume_ma = ta.sma(volume, 20)
volume_ratio = volume / volume_ma
volume_increasing = volume > volume[1] and volume > volume_ma

// PERMANENT FIX: Calculate Keltner Channels anchored to SMA (statistical boundary)
// This is the CORRECT formula that produced 1025% backtest returns
// Brackets represent statistical volatility zones, NOT moving price levels
upper_bracket = sma_value + (multiplier * atr_value)
lower_bracket = sma_value - (multiplier * atr_value)

// ATR volatility filter
atr_pct = atr_value / close
atr_in_range = atr_pct >= min_atr_pct and atr_pct <= max_atr_pct

// SMA slope (trend confirmation)
sma_slope_up = sma_value > sma_value[1]
sma_slope_down = sma_value < sma_value[1]

// RSI bias
rsi_up_bias = rsi_value > 50
rsi_down_bias = rsi_value < 50

// ===========================
// MARKET REGIME DETECTION
// ===========================
// Detect market regime (matches Python implementation)
adx_value = ta.sma(ta.tr, 14)  // Simplified ADX proxy
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)

regime_trending_up = ema20 > ema50 and sma_slope_up and rsi_value > 55
regime_trending_down = ema20 < ema50 and sma_slope_down and rsi_value < 45
regime_choppy = ta.stdev(close, 20) > atr_value * 1.5 and not regime_trending_up and not regime_trending_down
regime_crisis = atr_pct > 0.05  // ATR > 5% of price = crisis
regime_flat = not regime_trending_up and not regime_trending_down and not regime_choppy and not regime_crisis

// ===========================
// MOMENTUM STRENGTH DETECTION
// ===========================
// Calculate momentum score (matches Python calculation)
momentum_score = (rsi_value - 50) / 50  // RSI contribution (-1 to +1)

// Momentum strength classification
momentum_very_strong = math.abs(momentum_score) >= 0.6
momentum_strong = math.abs(momentum_score) >= 0.4 and math.abs(momentum_score) < 0.6
momentum_moderate = math.abs(momentum_score) >= 0.2 and math.abs(momentum_score) < 0.4
momentum_weak = math.abs(momentum_score) < 0.2

// ===========================
// OVERBOUGHT/TOP-BUYING PROTECTION (CRITICAL FIX)
// ===========================
// PREVENTS buying at market tops - added Nov 25, 2024
// Calculate distance from recent high (100 bars lookback)
recent_high = ta.highest(high, 100)
distance_from_high_pct = ((recent_high - close) / recent_high) * 100

// Protection rules for BUY signals
overbought_extreme = rsi_value > 75  // Rule 1: Extreme overbought
overbought_double_top = rsi_value > 70 and distance_from_high_pct < 2.0  // Rule 2: Double top risk
overbought_blowoff = distance_from_high_pct < 0.5 and atr_pct > 0.03  // Rule 3: Blow-off top

// Additional protection: Prevent trading during extreme volatility spikes
extreme_volatility = atr_pct > 0.04  // ATR > 4% indicates extreme volatility

// Reject BUY if any overbought condition triggers or extreme volatility
buy_allowed = not (overbought_extreme or overbought_double_top or overbought_blowoff or extreme_volatility)

// OVERSOLD/BOTTOM-SELLING PROTECTION
// Calculate distance from recent low (100 bars lookback)
recent_low = ta.lowest(low, 100)
// FIXED: When price is 5% ABOVE low, this gives 5.0 (positive)
// When price is AT low, this gives 0.0
// When price is BELOW low, this would give negative (new low)
distance_from_low_pct = ((close - recent_low) / recent_low) * 100

// Protection rules for SELL signals
oversold_extreme = rsi_value < 25  // Rule 1: Extreme oversold
oversold_double_bottom = rsi_value < 30 and distance_from_low_pct < 2.0  // Rule 2: Double bottom risk
oversold_capitulation = distance_from_low_pct < 0.5 and atr_pct > 0.03  // Rule 3: Capitulation bottom

// Reject SELL if any oversold condition triggers or extreme volatility
sell_allowed = not (oversold_extreme or oversold_double_bottom or oversold_capitulation or extreme_volatility)

// ===========================
// SIGNAL GENERATION
// ===========================
// LONG ENTRY: Price breaks upper bracket + SMA uptrend + RSI bullish + ATR valid + NOT OVERBOUGHT + Volume confirmation
long_condition = close > upper_bracket and sma_slope_up and rsi_up_bias and atr_in_range and buy_allowed and volume_increasing

// SHORT ENTRY: Price breaks lower bracket + SMA downtrend + RSI bearish + ATR valid + NOT OVERSOLD + Volume confirmation
short_condition = close < lower_bracket and sma_slope_down and rsi_down_bias and atr_in_range and sell_allowed and volume_increasing

// Signal confidence (scaled with RSI)
long_confidence = math.min(85, math.round(50 + (rsi_value - 50) * 0.7))
short_confidence = math.min(85, math.round(50 + (50 - rsi_value) * 0.7))

// ===========================
// FULLY DYNAMIC TRAILING SL/TP
// ===========================
// PRODUCTION-GRADE: Continuously updates every bar based on:
// - Current ATR (volatility changes)
// - Market regime shifts
// - Momentum strength fluctuations
// - Price movement (trailing stop)

// Track position state
var bool in_position = false
var string current_direction = na
var float entry_price = na
var float highest_price_since_entry = na
var float lowest_price_since_entry = na
var bool trailing_activated = false  // NEW: Track if trailing has activated
var int bars_since_exit = 0  // Track bars since last position exit

// Update bars since exit counter
if not in_position
    bars_since_exit := bars_since_exit + 1

// Minimum bars between trades (cooldown period to avoid overtrading)
min_bars_between_trades = 5

// Detect new signals with position safety check and cooldown period
bool new_long = long_condition and not long_condition[1] and not in_position and bars_since_exit >= min_bars_between_trades
bool new_short = short_condition and not short_condition[1] and not in_position and bars_since_exit >= min_bars_between_trades

// Enter position on new signal
if new_long
    in_position := true
    current_direction := "BUY"
    entry_price := close
    highest_price_since_entry := close
    lowest_price_since_entry := close
    trailing_activated := false  // Reset trailing state
    bars_since_exit := 0  // Reset cooldown counter

if new_short
    in_position := true
    current_direction := "SELL"
    entry_price := close
    highest_price_since_entry := close
    lowest_price_since_entry := close
    trailing_activated := false  // Reset trailing state
    bars_since_exit := 0  // Reset cooldown counter

// Update high/low tracking while in position
if in_position and current_direction == "BUY"
    highest_price_since_entry := math.max(highest_price_since_entry, close)
if in_position and current_direction == "SELL"
    lowest_price_since_entry := math.min(lowest_price_since_entry, close)

// ===========================
// HYBRID TRAILING SL CALCULATION (UPDATES EVERY BAR)
// ===========================
// Phase 1: Wait for 3% profit confirmation before trailing (avoids "red arrow massacre")
// Phase 2: Trail continuously using 3.0x ATR multiplier (wider, safer)

// Regime-adaptive SL multiplier (wider in trends to avoid stops, tighter in choppy/crisis)
regime_sl_mult = regime_trending_up ? 1.3 : regime_trending_down ? 1.0 : regime_choppy ? 0.7 : regime_crisis ? 0.6 : 1.0

// SL distance (3.0x ATR base * regime multiplier)
sl_distance = base_sl_multiplier * atr_value * regime_sl_mult

// Calculate profit percentage
var float profit_pct = 0.0
if in_position and current_direction == "BUY" and not na(entry_price)
    profit_pct := ((close - entry_price) / entry_price) * 100
if in_position and current_direction == "SELL" and not na(entry_price)
    profit_pct := ((entry_price - close) / entry_price) * 100

// Phase 1: DYNAMIC activation threshold based on market regime and ATR
// Calculate regime-adaptive activation threshold
float activation_threshold = 0.0
if regime_trending_up
    activation_threshold := 1.5  // Lower in strong trends (let it trail sooner)
else if regime_trending_down
    activation_threshold := 2.0  // Moderate in downtrends
else if regime_choppy
    activation_threshold := 1.0  // Very low in choppy (trail fast, lock profits)
else if regime_crisis
    activation_threshold := 2.5  // Higher in crisis (wait for confirmation)
else  // FLAT
    activation_threshold := 1.5  // Moderate in flat markets

// ATR adjustment: Higher volatility = higher threshold (need more confirmation)
atr_adjustment = (atr_pct / 0.015) * 0.5  // Base ATR 1.5% = no adjustment, higher ATR = +0.5% per 1.5% ATR
final_activation_threshold = activation_threshold + atr_adjustment

// Activate trailing after DYNAMIC profit confirmation
if in_position and profit_pct >= final_activation_threshold and not trailing_activated
    trailing_activated := true

// Calculate HYBRID TRAILING stop loss
var float stop_loss_price = na

if in_position and current_direction == "BUY"
    if trailing_activated
        // Phase 2: Continuous trailing from highest price (after 3% confirmation)
        trailing_sl = highest_price_since_entry - sl_distance
        stop_loss_price := na(stop_loss_price) ? trailing_sl : math.max(stop_loss_price, trailing_sl)
    else
        // Phase 1: Static SL (waiting for 3% confirmation)
        stop_loss_price := entry_price - (entry_price * 0.02)  // Initial SL at -2%

    // Exit if stopped out
    if close <= stop_loss_price
        in_position := false
        current_direction := na
        entry_price := na
        highest_price_since_entry := na
        lowest_price_since_entry := na
        trailing_activated := false

if in_position and current_direction == "SELL"
    if trailing_activated
        // Phase 2: Continuous trailing from lowest price (after 3% confirmation)
        trailing_sl = lowest_price_since_entry + sl_distance
        stop_loss_price := na(stop_loss_price) ? trailing_sl : math.min(stop_loss_price, trailing_sl)
    else
        // Phase 1: Static SL (waiting for 3% confirmation)
        stop_loss_price := entry_price + (entry_price * 0.02)  // Initial SL at +2%

    // Exit if stopped out
    if close >= stop_loss_price
        in_position := false
        current_direction := na
        entry_price := na
        highest_price_since_entry := na
        lowest_price_since_entry := na
        trailing_activated := false

// Reset SL if not in position
if not in_position
    stop_loss_price := na
    trailing_activated := false

// ===========================
// DYNAMIC TP CALCULATION (UPDATES EVERY BAR)
// ===========================
// CRITICAL FIX: Realistic R:R ratios based on actual market conditions
// Issue: Previous ratios (6.0x) created unreachable TP levels (TP3 +34%)
// Solution: Conservative ratios aligned with typical intraday moves
// Reference: BTC daily range ~2-3%, SOL ~3-5%, ETH ~2-4%
float rr1 = na
float rr2 = na
float rr3 = na

if regime_trending_up
    rr1 := 1.5  // TP1: 1.5x (realistic - was 2.5x)
    rr2 := 2.0  // TP2: 2.0x (realistic - was 4.0x)
    rr3 := 3.0  // TP3: 3.0x (realistic - was 6.0x)
else if regime_trending_down
    rr1 := 1.5  // TP1: 1.5x (realistic - was 2.0x)
    rr2 := 2.0  // TP2: 2.0x (realistic - was 3.0x)
    rr3 := 2.5  // TP3: 2.5x (realistic - was 4.5x)
else if regime_choppy
    rr1 := 1.2  // TP1: 1.2x (very conservative - was 1.5x)
    rr2 := 1.5  // TP2: 1.5x (very conservative - was 2.5x)
    rr3 := 2.0  // TP3: 2.0x (very conservative - was 3.5x)
else if regime_crisis
    rr1 := 1.2  // TP1: 1.2x (conservative in crisis - was 1.5x)
    rr2 := 1.5  // TP2: 1.5x (conservative in crisis - was 2.0x)
    rr3 := 2.0  // TP3: 2.0x (conservative in crisis - was 3.0x)
else  // FLAT regime
    rr1 := 1.3  // TP1: 1.3x (realistic - was 2.0x)
    rr2 := 1.8  // TP2: 1.8x (realistic - was 3.0x)
    rr3 := 2.5  // TP3: 2.5x (realistic - was 4.0x)

// Momentum multiplier (recalculates with momentum changes)
// CRITICAL FIX: Reduced momentum multipliers to prevent unrealistic TPs
// Previous: VERY_STRONG = 1.3x → TP3 could reach 3.0*1.3 = 3.9x (too optimistic)
// New: Capped at 1.15x max to keep TPs realistic
rr_multiplier = momentum_very_strong ? 1.15 : momentum_strong ? 1.10 : momentum_weak ? 0.90 : 1.0

// Adjusted RR ratios (updates every bar)
adjusted_rr1 = rr1 * rr_multiplier
adjusted_rr2 = rr2 * rr_multiplier
adjusted_rr3 = rr3 * rr_multiplier

// Calculate TP prices (updates continuously based on current entry and SL distance)
var float tp1_price = na
var float tp2_price = na
var float tp3_price = na

if in_position and current_direction == "BUY" and not na(entry_price)
    tp1_price := entry_price + (sl_distance * adjusted_rr1)
    tp2_price := entry_price + (sl_distance * adjusted_rr2)
    tp3_price := entry_price + (sl_distance * adjusted_rr3)

    // Exit if TP3 hit
    if close >= tp3_price
        in_position := false
        current_direction := na
        entry_price := na
        highest_price_since_entry := na
        lowest_price_since_entry := na
        trailing_activated := false

if in_position and current_direction == "SELL" and not na(entry_price)
    tp1_price := entry_price - (sl_distance * adjusted_rr1)
    tp2_price := entry_price - (sl_distance * adjusted_rr2)
    tp3_price := entry_price - (sl_distance * adjusted_rr3)

    // Exit if TP3 hit
    if close <= tp3_price
        in_position := false
        current_direction := na
        entry_price := na
        highest_price_since_entry := na
        lowest_price_since_entry := na
        trailing_activated := false

// Reset TPs if not in position
if not in_position
    tp1_price := na
    tp2_price := na
    tp3_price := na

// ===========================
// VISUAL DISPLAY
// ===========================
// Plot SMA
plot(show_sma ? sma_value : na, "SMA", color=color.yellow, linewidth=2)

// Plot Keltner Brackets
upper_plot = plot(show_brackets ? upper_bracket : na, "Upper Bracket", color=color.new(color.green, 30), linewidth=2)
lower_plot = plot(show_brackets ? lower_bracket : na, "Lower Bracket", color=color.new(color.red, 30), linewidth=2)
fill(upper_plot, lower_plot, color=color.new(color.gray, 90), title="Bracket Zone")

// Plot DYNAMIC TRAILING SL/TP Levels (updates every bar while in position)
var line sl_line = na
var line tp1_line = na
var line tp2_line = na
var line tp3_line = na
var label sl_label = na
var label tp1_label = na
var label tp2_label = na
var label tp3_label = na

// Always delete old lines/labels on every bar
line.delete(sl_line[1])
line.delete(tp1_line[1])
line.delete(tp2_line[1])
line.delete(tp3_line[1])
label.delete(sl_label[1])
label.delete(tp1_label[1])
label.delete(tp2_label[1])
label.delete(tp3_label[1])

// Draw lines ONLY while in position (updates every bar with trailing values)
if show_sl_tp and in_position and not na(stop_loss_price) and not na(tp1_price)
    // Draw TRAILING Stop Loss line (red, updates every bar)
    sl_line := line.new(bar_index, stop_loss_price, bar_index + 10, stop_loss_price, color=color.new(color.red, 0), width=2, style=line.style_dashed)
    sl_label := label.new(bar_index + 10, stop_loss_price, "🛑 SL: $" + str.tostring(stop_loss_price, "#,###.##") + " (TRAILING)", style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.small)

    // Draw DYNAMIC TP1 line (lime, updates with regime/momentum changes)
    tp1_line := line.new(bar_index, tp1_price, bar_index + 10, tp1_price, color=color.new(color.lime, 0), width=2, style=line.style_solid)
    tp1_label := label.new(bar_index + 10, tp1_price, "🎯 TP1: $" + str.tostring(tp1_price, "#,###.##") + " (" + str.tostring(adjusted_rr1, "#.#") + ":1)", style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.white, size=size.small)

    // Draw DYNAMIC TP2 line (green, updates with regime/momentum changes)
    tp2_line := line.new(bar_index, tp2_price, bar_index + 10, tp2_price, color=color.new(color.green, 0), width=2, style=line.style_solid)
    tp2_label := label.new(bar_index + 10, tp2_price, "🎯 TP2: $" + str.tostring(tp2_price, "#,###.##") + " (" + str.tostring(adjusted_rr2, "#.#") + ":1)", style=label.style_label_left, color=color.new(color.green, 20), textcolor=color.white, size=size.small)

    // Draw DYNAMIC TP3 line (teal, updates with regime/momentum changes)
    tp3_line := line.new(bar_index, tp3_price, bar_index + 10, tp3_price, color=color.new(color.teal, 0), width=2, style=line.style_solid)
    tp3_label := label.new(bar_index + 10, tp3_price, "🎯 TP3: $" + str.tostring(tp3_price, "#,###.##") + " (" + str.tostring(adjusted_rr3, "#.#") + ":1)", style=label.style_label_left, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)

// Plot buy/sell signals
plotshape(show_signals and long_condition, "BUY Signal", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small, text="BUY")
plotshape(show_signals and short_condition, "SELL Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small, text="SELL")

// ===========================
// INFO PANEL (Top Right)
// ===========================
if show_info and barstate.islast
    // Calculate position in bracket (0-100%)
    bracket_range = upper_bracket - lower_bracket
    position_in_range = bracket_range != 0 ? ((close - lower_bracket) / bracket_range) * 100 : 50

    // Calculate distance to breakout
    distance_to_upper = ((upper_bracket - close) / close) * 100
    distance_to_lower = ((close - lower_bracket) / close) * 100

    // Regime display
    regime_text = regime_trending_up ? "TRENDING UP" : regime_trending_down ? "TRENDING DOWN" : regime_choppy ? "CHOPPY" : regime_crisis ? "CRISIS" : "FLAT"

    // Momentum display
    momentum_text = momentum_very_strong ? "VERY STRONG" : momentum_strong ? "STRONG" : momentum_moderate ? "MODERATE" : "WEAK"

    // Build info text
    info_text = ""
    info_text += "┌─ VOLATILITY BRACKET ─┐\n"
    info_text += "│ Price: $" + str.tostring(close, "#,###.##") + "\n"
    info_text += "│ \n"
    info_text += "│ Upper: $" + str.tostring(upper_bracket, "#,###.##") + "\n"
    info_text += "│ Lower: $" + str.tostring(lower_bracket, "#,###.##") + "\n"
    info_text += "│ \n"
    info_text += "│ Position: " + str.tostring(position_in_range, "#.#") + "%\n"
    info_text += "│ \n"
    info_text += "│ RSI: " + str.tostring(rsi_value, "#.#")
    info_text += rsi_up_bias ? " ↑" : " ↓"
    info_text += "\n"
    info_text += "│ SMA Trend: "
    info_text += sma_slope_up ? "UP ✓" : (sma_slope_down ? "DOWN ✓" : "FLAT")
    info_text += "\n"
    info_text += "│ ATR: " + str.tostring(atr_pct * 100, "#.##") + "%"
    info_text += atr_in_range ? " ✓" : " ✗"
    info_text += "\n"
    info_text += "│ \n"
    info_text += "│ Regime: " + regime_text + "\n"
    info_text += "│ Momentum: " + momentum_text + "\n"
    info_text += "│ \n"

    // Current position status with DYNAMIC SL/TP info
    if in_position and current_direction == "BUY"
        // Show LIVE position status
        pnl_pct = ((close - entry_price) / entry_price) * 100
        pnl_color = pnl_pct > 0 ? "🟢" : "🔴"
        info_text += "│ 💼 IN POSITION: LONG\n"
        info_text += "│ " + pnl_color + " P&L: " + str.tostring(pnl_pct, "#.##") + "%\n"
        info_text += "│ \n"
        info_text += "│ Entry: $" + str.tostring(entry_price, "#,###.##") + "\n"
        info_text += "│ Current: $" + str.tostring(close, "#,###.##") + "\n"
        info_text += "│ High: $" + str.tostring(highest_price_since_entry, "#,###.##") + "\n"
        if show_sl_tp and not na(stop_loss_price)
            info_text += "│ \n"
            info_text += "│ 🛑 TRAILING SL: $" + str.tostring(stop_loss_price, "#,###.##") + "\n"
            info_text += "│ 🎯 TP1: $" + str.tostring(tp1_price, "#,###.##") + " (" + str.tostring(adjusted_rr1, "#.#") + ":1)\n"
            info_text += "│ 🎯 TP2: $" + str.tostring(tp2_price, "#,###.##") + " (" + str.tostring(adjusted_rr2, "#.#") + ":1)\n"
            info_text += "│ 🎯 TP3: $" + str.tostring(tp3_price, "#,###.##") + " (" + str.tostring(adjusted_rr3, "#.#") + ":1)\n"
    else if in_position and current_direction == "SELL"
        // Show LIVE position status
        pnl_pct = ((entry_price - close) / entry_price) * 100
        pnl_color = pnl_pct > 0 ? "🟢" : "🔴"
        info_text += "│ 💼 IN POSITION: SHORT\n"
        info_text += "│ " + pnl_color + " P&L: " + str.tostring(pnl_pct, "#.##") + "%\n"
        info_text += "│ \n"
        info_text += "│ Entry: $" + str.tostring(entry_price, "#,###.##") + "\n"
        info_text += "│ Current: $" + str.tostring(close, "#,###.##") + "\n"
        info_text += "│ Low: $" + str.tostring(lowest_price_since_entry, "#,###.##") + "\n"
        if show_sl_tp and not na(stop_loss_price)
            info_text += "│ \n"
            info_text += "│ 🛑 TRAILING SL: $" + str.tostring(stop_loss_price, "#,###.##") + "\n"
            info_text += "│ 🎯 TP1: $" + str.tostring(tp1_price, "#,###.##") + " (" + str.tostring(adjusted_rr1, "#.#") + ":1)\n"
            info_text += "│ 🎯 TP2: $" + str.tostring(tp2_price, "#,###.##") + " (" + str.tostring(adjusted_rr2, "#.#") + ":1)\n"
            info_text += "│ 🎯 TP3: $" + str.tostring(tp3_price, "#,###.##") + " (" + str.tostring(adjusted_rr3, "#.#") + ":1)\n"
    else if long_condition
        info_text += "│ 🚀 NEW BUY SIGNAL!\n"
        info_text += "│ Confidence: " + str.tostring(long_confidence) + "%\n"
    else if short_condition
        info_text += "│ 📉 NEW SELL SIGNAL!\n"
        info_text += "│ Confidence: " + str.tostring(short_confidence) + "%\n"
    else if close > sma_value
        info_text += "│ Status: No Position\n"
        info_text += "│ In Range (Upper)\n"
        info_text += "│ Need: +" + str.tostring(distance_to_upper, "#.##") + "% to BUY\n"
    else
        info_text += "│ Status: No Position\n"
        info_text += "│ In Range (Lower)\n"
        info_text += "│ Need: -" + str.tostring(distance_to_lower, "#.##") + "% to SELL\n"

    info_text += "└───────────────────────┘"

    // Display info box with dynamic positioning
    var label info_label = na
    label.delete(info_label)

    // Determine label size
    label_size = info_size == "Small" ? size.small : info_size == "Large" ? size.large : size.normal

    // Determine position and style based on user selection
    label_y = info_position == "Top Left" or info_position == "Top Right" ? high : low
    label_style = info_position == "Top Left" or info_position == "Top Right" ? label.style_label_down : label.style_label_up
    label_x = info_position == "Top Left" or info_position == "Bottom Left" ? bar_index - 20 : bar_index

    info_label := label.new(label_x, label_y, info_text, style=label_style, color=color.new(color.black, 10), textcolor=color.white, size=label_size, textalign=text.align_left)

// ===========================
// BACKGROUND COLORING
// ===========================
// Color background for position status (continuous while in position)
bgcolor(in_position and current_direction == "BUY" ? color.new(color.green, 95) : na, title="Long Position BG")
bgcolor(in_position and current_direction == "SELL" ? color.new(color.red, 95) : na, title="Short Position BG")

// Highlight new entry signals with brighter color
bgcolor(new_long ? color.new(color.green, 80) : na, title="New BUY Signal BG")
bgcolor(new_short ? color.new(color.red, 80) : na, title="New SELL Signal BG")

// ===========================
// ALERTS
// ===========================
// Entry alerts
alertcondition(new_long, title="🚀 BUY Signal", message="VolatilityBracket: BUY ENTRY - Price broke upper bracket with trend + RSI confirmation")
alertcondition(new_short, title="📉 SELL Signal", message="VolatilityBracket: SELL ENTRY - Price broke lower bracket with trend + RSI confirmation")

// Exit alerts (stop loss and take profit)
alertcondition(in_position[1] and not in_position and current_direction[1] == "BUY" and close <= stop_loss_price[1], title="🛑 LONG Stop Loss Hit", message="VolatilityBracket: LONG position stopped out at trailing SL")
alertcondition(in_position[1] and not in_position and current_direction[1] == "SELL" and close >= stop_loss_price[1], title="🛑 SHORT Stop Loss Hit", message="VolatilityBracket: SHORT position stopped out at trailing SL")
alertcondition(in_position[1] and not in_position and current_direction[1] == "BUY" and close >= tp3_price[1], title="🎯 LONG Take Profit Hit", message="VolatilityBracket: LONG position hit TP3 target!")
alertcondition(in_position[1] and not in_position and current_direction[1] == "SELL" and close <= tp3_price[1], title="🎯 SHORT Take Profit Hit", message="VolatilityBracket: SHORT position hit TP3 target!")

// ===========================
// STRATEGY NOTES
// ===========================
// This indicator matches the EXACT logic of the production Python strategy:
//
// BUY CONDITIONS (ALL must be true):
// 1. Price > Upper Bracket (SMA + multiplier × ATR)
// 2. SMA rising (uptrend)
// 3. RSI > 50 (bullish bias)
// 4. ATR between 0.5% - 3.0% of price (volatility filter)
// 5. NOT overbought (RSI < 75, not near recent high, no blow-off top)
// 6. Volume confirmation (volume > MA and increasing)
// 7. Not in extreme volatility (ATR < 4%)
//
// SELL CONDITIONS (ALL must be true):
// 1. Price < Lower Bracket (SMA - multiplier × ATR)
// 2. SMA falling (downtrend)
// 3. RSI < 50 (bearish bias)
// 4. ATR between 0.5% - 3.0% of price (volatility filter)
// 5. NOT oversold (RSI > 25, not near recent low, no capitulation)
// 6. Volume confirmation (volume > MA and increasing)
// 7. Not in extreme volatility (ATR < 4%)
//
// HYBRID TRAILING STOP LOSS (PRODUCTION-GRADE):
// - Phase 1: Wait for 3% profit confirmation (avoids "red arrow massacre" from premature stops)
// - Phase 2: Trail continuously from highest/lowest price (never moves against you)
// - BUY: SL = Highest Price Since Entry - (3.0 × ATR × regime_multiplier)
// - SELL: SL = Lowest Price Since Entry + (3.0 × ATR × regime_multiplier)
// - UPDATES EVERY BAR: Recalculates with ATR and regime changes after activation
// - Regime multipliers (adaptive): TRENDING_UP=1.3 (wider), CHOPPY=0.7, CRISIS=0.6 (tighter)
//
// FULLY DYNAMIC TAKE PROFIT (PRODUCTION-GRADE):
// - UPDATES EVERY BAR: Recalculates with regime and momentum changes
// - RR Ratios by CURRENT regime (not entry regime) - UPDATED FOR REALISM:
//   - TRENDING_UP: [1.5, 2.0, 3.0]  // Reduced from [2.5, 4.0, 6.0]
//   - TRENDING_DOWN: [1.5, 2.0, 2.5]  // Reduced from [2.0, 3.0, 4.5]
//   - CHOPPY: [1.2, 1.5, 2.0]  // Reduced from [1.5, 2.5, 3.5]
//   - FLAT: [1.3, 1.8, 2.5]  // Reduced from [2.0, 3.0, 4.0]
//   - CRISIS: [1.2, 1.5, 2.0]  // Reduced from [1.5, 2.0, 3.0]
// - Momentum multipliers (LIVE): VERY_STRONG=1.15, STRONG=1.10, MODERATE=1.0, WEAK=0.90
// - TP Price = Entry ± (sl_distance × RR_ratio × momentum_multiplier)
// - AUTO EXIT: Closes position at TP3 or stop loss hit
//
// CRITICAL INSIGHT:
// The strategy uses SMA as the anchor for Keltner Channels, NOT previous close.
// This creates FIXED statistical boundaries that price can break through.
// Using prev_close would create a moving target that chases price - THIS IS THE BUG WE FIXED!
//
// BACKTEST RESULTS:
// BTC 1h: 1025% return, 0.52 Sharpe, 15 trades
// SOL 1h: 726% return, 0.34 Sharpe, 13 trades
// ETH 1h: 236% return, 0.23 Sharpe, 31 trades
//
